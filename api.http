@base = http://localhost:8080/api/rooms

# Run reset.sql before running these requests, the expected results are only valid on a cleanly reset database.

### 1. GET all rooms (expect 200, 3 seeded rooms)
GET {{base}}

### 2. GET filtered by capacity (expect 200, 2 rooms: Seminar A and Rooftop Room)
GET {{base}}?minCapacity=6

### 3. GET filtered by keyword (expect 200, 1 room: Study Pod)
GET {{base}}?keyword=pod

### 4. GET filtered by capacity and keyword (expect 200, 1 room: Rooftop Room)
GET {{base}}?minCapacity=6&keyword=roof

### 5. GET room 1 (expect 200, Seminar A)
GET {{base}}/1

### 6. GET a room that doesn't exist (expect 404)
GET {{base}}/99

### 7. POST a new room (expect 201 + Location: /api/rooms/4)
POST {{base}}
Content-Type: application/json

{ "name": "Room A", "capacity": 10 }

### 8. PUT update room 4 (expect 200)
PUT {{base}}/4
Content-Type: application/json

{ "name": "Room A updated", "capacity": 11 }

### 9. PUT a room that doesn't exist (expect 404)
PUT {{base}}/99
Content-Type: application/json

{ "name": "Non-existent room", "capacity": 5 }

### 10. DELETE room 4 (expect 204)
DELETE {{base}}/4

### 11. GET the now deleted room 4 (expect 404)
GET {{base}}/4

### 12. POST with capacity above the allowed range (expect 400)
POST {{base}}
Content-Type: application/json

{ "name": "A room too big", "capacity": 21 }

### 13. GET with a non-number minCapacity (expect 400)
GET {{base}}?minCapacity=abc

### 14. GET room count (expect 200, 3 -- console shows select count(*))
GET {{base}}/count

### 15. DELETE a room that has reservations (expect 409)
DELETE {{base}}/1

### 16. PUT with capacity above the allowed range (expect 400)
PUT {{base}}/1
Content-Type: application/json

{ "name": "A room too big", "capacity": 21 }

### 17. DELETE room 4 again (expect 404)
DELETE {{base}}/4
